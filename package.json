{
  "name": "mbti",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "초정밀 MBTI 성격유형 검사",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "icons": "node tools/make-icons.mjs && npx @capacitor/assets generate --android",
    "verify": "node tools/verify-types.mjs",
    "shots": "node tools/shots.mjs",
    "feature": "node tools/feature-graphic.mjs",
    "android:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "puppeteer-core": "^25.11.0",
    "vite": "^5.4.11"
  }
}
